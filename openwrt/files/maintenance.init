#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# One-shot root task supervised independently of rpcd and the proxy process.
USE_PROCD=1
start_service() {
	local job_id="$1"
	case "$job_id" in ''|*[!a-f0-9]*) return 1 ;; esac
	[ "${#job_id}" = 24 ] || return 1
	procd_open_instance task
	procd_set_param command /usr/libexec/daed/luci-proxy --maintenance worker --maintenance-job "$job_id"
	procd_set_param term_timeout 120
	procd_set_param stderr 1
	procd_close_instance
}
